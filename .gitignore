cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment variables / secrets
.env
*.env

# Data files - usually do NOT commit large/raw data
data/
*.csv
*.parquet
*.xlsx
*.zip

# Models / artifacts
models/
artifacts/
*.pkl
*.joblib

# OS/editor
.DS_Store
.vscode/
.idea/
EOF
